// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  extensions = [vector]
}

enum Rol {
  SUPERUSUARIO
  ADMINISTRADOR
  CIUDADANO
}

enum TipoSector {
  MINISTERIO
  SUBSECRETARIA
  DEPARTAMENTO
  ORGANISMO
}

enum Jurisdiccion {
  PROVINCIAL
  MUNICIPAL
  NACIONAL
}

enum EstadoUsuario {
  PENDIENTE
  APROBADO
  RECHAZADO
  SUSPENDIDO
}

enum Genero {
  M
  F
  X
}

model Sector {
  id        Int @id @default(autoincrement())
  nombre    String
  tipo      TipoSector
  // null en los dos: igual que el sector padre (en un sector raíz, provincial y sin localidad).
  jurisdiccion Jurisdiccion?
  localidad    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parentId  Int? @map("parent_id")
  parent    Sector? @relation("Jerarquia", fields: [parentId], references: [id], onDelete: SetNull)
  hijos Sector[] @relation("Jerarquia")

  tramites      Tramite[]
  mesasEntrada  MesaEntrada[]
  usuarios      UsuarioSector[]

  @@unique([nombre, parentId])
  @@index([parentId])
  @@map("sectores")
}

model Tramite {
  id          Int @id @default(autoincrement())
  nombre      String
  descripcion String
  costo       Decimal? @db.Decimal(12, 2)
  encargadoId Int      @map("encargado_id")
  encargado   Usuario  @relation(fields: [encargadoId], references: [id])
  publicado   Boolean @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  embedding Unsupported("vector(1536)")?
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('spanish'::regconfig, ((COALESCE(nombre, ''::text) || ' '::text) || COALESCE(descripcion, ''::text)))")) @map("search_vector")

  sectorId  Int @map("sector_id")
  sector    Sector @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  requisitos  Requisito[]
  documentos  Documento[]
  mesas       TramiteMesa[]
  consultas   Consulta[]

  fuenteUrl   String?  @unique @map("fuente_url")

  // De la ficha del portal (ver la migración fichas_del_portal).
  informacionAdicional String?   @map("informacion_adicional")
  costoDetalle         String?   @map("costo_detalle")
  verificadoEn         DateTime? @map("verificado_en")
  // Hash de lo que escribió el importador, por grupo de campos (ver src/utils/huella.js).
  huellaImportacion    Json?     @map("huella_importacion")

  @@index([sectorId])
  @@index([embedding], map: "tramites_embedding_idx")
  @@index([searchVector], map: "tramites_search_idx", type: Gin)
  @@map("tramites")
}

model Requisito {
  id              Int @id @default(autoincrement())
  descripcion     String
  dondeSeConsigue String? @map("donde_se_consigue")
  costo           Decimal? @db.Decimal(12, 2)

  tramiteId Int @map("tramite_id")
  tramite   Tramite @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  @@index([tramiteId])
  @@map("requisitos")
}

model MesaEntrada {
  id        Int @id @default(autoincrement())
  nombre    String
  direccion String?
  localidad String?
  horario   String?
  telefono  String?
  email     String?
  esGeneral Boolean @default(false) @map("es_general")
  // Identificador de la oficina en el portal (collapse_NNN): evita duplicarla entre trámites.
  origenId  String? @unique @map("origen_id")
  huellaImportacion Json? @map("huella_importacion")

  sectorId  Int? @map("sector_id")
  sector    Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)

  tramites  TramiteMesa[]

  @@index([sectorId])
  @@map("mesas_entrada")
}

model TramiteMesa {
  tramiteId Int @map("tramite_id")
  mesaId    Int @map("mesa_id")

  tramite   Tramite @relation(fields: [tramiteId], references: [id], onDelete: Cascade)
  mesa      MesaEntrada @relation(fields: [mesaId], references: [id], onDelete: Cascade)

  @@id([tramiteId, mesaId])
  @@map("tramite_mesa")
}

model Documento {
  id        Int @id @default(autoincrement())
  nombre    String
  // Exactamente uno de los dos (CHECK en la migración): clave del archivo en R2 o enlace http(s).
  archivo    String?
  urlExterna String? @map("url_externa")
  tipo      String?
  createdAt DateTime @default(now()) @map("created_at")

  tramiteId Int @map("tramite_id")
  tramite   Tramite @relation(fields: [tramiteId], references: [id], onDelete: Cascade)

  @@index([tramiteId])
  @@map("documentos")
}

model Usuario {
  id            Int @id @default(autoincrement())
  nombre        String
  email         String @unique
  passwordHash  String @map("password_hash")
  rol           Rol @default(ADMINISTRADOR)
  estado        EstadoUsuario @default(PENDIENTE)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  dni           String? @unique
  genero        Genero?
  cuil          String? @unique @db.VarChar(11)
  resetTokenHash String?  @map("reset_token_hash")
  resetTokenExpira DateTime?  @map("reset_token_expira")
  debeCambiarPassword Boolean @default(false) @map("debe_cambiar_password")
  passwordCambiadaEn  DateTime? @map("password_cambiada_en")

  sectores      UsuarioSector[]
  tramitesACargo Tramite[]
  consultas     Consulta[]

  @@map("usuarios")
}

model UsuarioSector {
  usuarioId Int @map("usuario_id")
  sectorId  Int @map("sector_id")

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([usuarioId, sectorId])
  @@map("usuario_sector")
}

model Consulta {
  id              Int @id @default(autoincrement())
  textoConsulta   String @map("texto_consulta")
  encontrado      Boolean @default(false)
  fecha           DateTime @default(now())
  respuesta       String?
  topico          String?
  calificacion    Int?
  motivoCalificacion String? @map("motivo_calificacion")
  calificarToken  String? @unique @map("calificar_token")

  tramiteId Int? @map("tramite_id")
  tramite Tramite? @relation(fields: [tramiteId], references: [id], onDelete: SetNull)
  usuarioId       Int?  @map("usuario_id")
  usuario         Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([tramiteId])
  @@index([usuarioId])
  @@map("consultas")
}

// Una sola fila (id = 1). Ver version-catalogo.service.js.
model CatalogoVersion {
  id            Int      @id @default(1)
  version       BigInt   @default(0)
  actualizadoEn DateTime @default(now()) @map("actualizado_en")

  @@map("catalogo_version")
}
