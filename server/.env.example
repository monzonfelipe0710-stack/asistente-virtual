# Puerto del servidor (por defecto 3000)
PORT=3000

# Cadena de conexión a PostgreSQL (requiere la extensión pgvector)
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/chatap

# Secreto para firmar los JWT. Usá un valor largo y aleatorio.
JWT_SECRET=

# Vigencia del token de sesión (formato de la librería jsonwebtoken).
JWT_EXPIRES_IN=2h

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5173

# Saltos de proxy a confiar para obtener la IP real del cliente (rate limiting).
# Dejar vacío si el servidor se expone directo. Detrás de un reverse proxy: 1.
TRUST_PROXY=

# Cloudflare R2 (API compatible con S3) para los documentos de los trámites.
# El endpoint tiene la forma https://<account_id>.r2.cloudflarestorage.com
# Obligatorias: el server no arranca sin ellas.
R2_ACCOUNT_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# API key de OpenAI (embeddings y chat). Obligatoria: el server no arranca sin ella.
OPENAI_API_KEY=

# Opcionales del chat. Van comentadas a propósito: una variable vacía (X=) llega como
# texto vacío y pisa el default (UMBRAL_DISTANCIA= queda en 0 y el chat no encuentra nada).
# Para cambiar una, descomentala con su valor.
# Modelo de las respuestas. El de embeddings es fijo en el código.
# OPENAI_MODELO_CHAT=gpt-4o-mini
# OPENAI_TEMPERATURA=0.3
# Distancia coseno máxima para que un trámite sea candidato en la búsqueda.
# UMBRAL_DISTANCIA=0.5
# Vigencia en milisegundos y cantidad máxima de entradas de la caché de respuestas.
# CACHE_TTL_MS=3600000
# CACHE_MAX=500

# URL de turnos de formosa, se utiliza para obtener el nombre mediante los datos solicitados en el registro.
# Obligatoria: el server no arranca sin ella.
TURNOS_URL=

# Correo interno y contraseña para el envio de correos de recuperacion.
# Obligatorias, igual que FRONTEND_URL (base del link de recuperación).
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=contraseña_de_aplicacion_de_16_caracteres
FRONTEND_URL=http://localhost:5173
